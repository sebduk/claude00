{
  "manifest_version": 3,
  "version": "5.0",
  "name": "WebtoonGrab",
  "description": "Auto browse to load all images, download locally, move on to next page",
  "permissions": ["tabs", "background", "storage"],
  "action": {
    "default_popup": "pu.grab.html",
    "default_icon": "pu.grab.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.webtoon.xyz/read/*/*-*"],
      "js": ["cs.grab.js"]
      }
    ],
  "background": {
    "service_worker": "bg.grab.js"
  }

}
