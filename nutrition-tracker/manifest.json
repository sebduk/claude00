{
  "manifest_version": 3,
  "name": "Nutrition Tracker",
  "version": "1.0.0",
  "description": "Track daily food intake, macros, exercise, and get smart eating tips",
  "permissions": ["storage", "alarms"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_page": "options/options.html"
}
